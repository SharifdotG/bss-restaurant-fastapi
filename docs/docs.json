          },
          {
            "group": "Public",
            "pages": [
              "GET /api/v1/public/restaurant",
              "GET /api/v1/public/menu",
              "GET /api/v1/public/tables/{qr_token}",
              "POST /api/v1/public/tables/{qr_token}/orders",
              "POST /api/v1/public/orders",
              "GET /api/v1/public/orders/{tracking_code}",
              "POST /api/v1/public/orders/{tracking_code}/cancel",
              "GET /api/v1/public/reservations/slots",
