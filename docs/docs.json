{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "BSS Restaurant Backend",
  "colors": {
    "primary": "#d63b00",
    "light": "#ff673d",
    "dark": "#d63b00"
  },
  "favicon": "/logo/mark.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "background": {
    "color": {
      "light": "#f3f6fa",
      "dark": "#0c1015"
    }
  },
  "fonts": {
    "family": "Google Sans Flex"
  },
  "appearance": {
    "default": "system"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "tech-stack",
              "project-structure"
            ]
          },
          {
            "group": "How it works",
            "pages": [
              "concepts/architecture",
              "concepts/auth-and-tokens",
              "concepts/roles",
              "concepts/orders",
              "concepts/payments-and-refunds",
              "concepts/reservations",
              "concepts/live-updates",
              "concepts/public-ordering",
              "concepts/images",
              "concepts/reports",
              "concepts/errors-and-limits"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/database",
              "guides/demo-data",
              "guides/deploy-to-fastapi-cloud",
              "guides/testing-and-ci"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/configuration",
              "reference/cli",
              "reference/glossary"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "GET /api/v1/health"
            ]
          },
          {
            "group": "Sign-in",
            "pages": [
              "POST /api/v1/auth/login",
              "POST /api/v1/auth/refresh",
              "POST /api/v1/auth/logout",
              "POST /api/v1/auth/logout-all",
              "GET /api/v1/auth/me",
              "PATCH /api/v1/auth/me",
              "POST /api/v1/auth/me/password",
              "POST /api/v1/auth/token"
            ]
          },
          {
            "group": "Restaurant",
            "pages": [
              "GET /api/v1/restaurant",
              "PATCH /api/v1/restaurant"
            ]
          },
          {
            "group": "Menu",
            "pages": [
              "GET /api/v1/categories",
