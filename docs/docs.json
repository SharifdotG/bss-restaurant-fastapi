              "POST /api/v1/reservations/{reservation_id}/status"
            ]
          },
          {
            "group": "Expenses",
            "pages": [
              "GET /api/v1/expenses",
              "POST /api/v1/expenses",
              "GET /api/v1/expenses/{expense_id}",
              "PATCH /api/v1/expenses/{expense_id}",
              "DELETE /api/v1/expenses/{expense_id}"
            ]
          },
          {
            "group": "Dashboard and reports",
            "pages": [
              "GET /api/v1/dashboard",
              "GET /api/v1/reports/sales",
              "GET /api/v1/reports/top-foods",
              "GET /api/v1/reports/expenses",
              "GET /api/v1/reports/staff",
              "GET /api/v1/reports/sales.csv",
              "GET /api/v1/reports/top-foods.csv",
              "GET /api/v1/reports/expenses.csv",
              "GET /api/v1/reports/staff.csv",
              "GET /api/v1/reports/orders.csv"
