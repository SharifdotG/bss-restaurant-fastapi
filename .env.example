ENVIRONMENT=local
DEBUG=true

# comma separated
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
DOCS_ENABLED=true

# neon: pooled url for the app, direct url for alembic
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant
DATABASE_URL_DIRECT=
DB_ECHO=false

# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=   (required outside local)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# file storage: local (default) or r2
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# public bucket url, e.g. https://pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=
MAX_UPLOAD_MB=5
