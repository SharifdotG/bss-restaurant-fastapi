ENVIRONMENT=local
DEBUG=true

# comma separated
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
DOCS_ENABLED=true

# neon: pooled url for the app, direct url for alembic
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant
DATABASE_URL_DIRECT=
DB_ECHO=false

# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=   (required outside local)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
