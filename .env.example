ENVIRONMENT=local
DEBUG=true
RESTAURANT_TZ=Asia/Dhaka

# comma separated
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
DOCS_ENABLED=true

# per ip limits on login and the public endpoints, off only for load testing
RATE_LIMIT_ENABLED=true
# proxies in front of the app, so the client ip can be read from X-Forwarded-For
TRUSTED_PROXY_HOPS=0
# or a header the edge proxy sets, e.g. cf-connecting-ip on fastapi cloud
# CLIENT_IP_HEADER=
# memory for one instance, postgres to share live updates between instances
LIVE_BACKEND=memory

# neon: paste the pooled connection string, migrations work out the direct one
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant
# only if your provider's direct url can't be derived from the pooled one
# DATABASE_URL_DIRECT=
DB_ECHO=false

# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=   (required outside local)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# file storage: local (default) or r2
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# public bucket url, e.g. https://pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=
MAX_UPLOAD_MB=5
